// Personal build settings. Copy this file to Config/User.xcconfig (it is not under
// version control) and fill in your values:
//
//   cp User.template.xcconfig Config/User.xcconfig

// Your Team ID, found at https://developer.apple.com/account.
// Leave empty to build for the simulator only.
DEVELOPMENT_TEAM =

// Something unique, typically com.<yourname>.TT5
BASE_PRODUCT_BUNDLE_IDENTIFIER = com.example.TT5

// App icon set in TT5/Assets.xcassets. 'AppIcon' is the bundled placeholder.
APP_ICON = AppIcon
