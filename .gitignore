# Xcode per-user state (breakpoints, scheme order, UI state)
xcuserdata/

# Xcode build output
build/
DerivedData/
*.ipa
*.dSYM
*.dSYM.zip

# Personal build settings, see User.template.xcconfig
Config/User.xcconfig

# App Store artwork (icon, logo, role badges), kept out of the public repo (see README)
TT5/Assets.xcassets/*Store.appiconset/
TT5/Assets.xcassets/*Store.imageset/
TT5/Resources/LaunchScreenStore.storyboard

# Local-only files: design sources, notes
Private/

# Logs
*.log

# JetBrains IDE
.idea/
*.iml

# macOS
.DS_Store
